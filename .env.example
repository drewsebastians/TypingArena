# ---------------------------------------------------------------------------
# TypingArena environment configuration
#
# Everything is OPTIONAL at build time: the site builds and runs fully without
# any of these values (shared features degrade honestly instead of faking data).
# Values marked PUBLIC are baked into the static export — never put secrets here.
# ---------------------------------------------------------------------------

# --- Canonical site ---------------------------------------------------------
# Public origin used for canonical URLs, sitemap and robots.
# Leave unset for local dev (http://localhost:3000).
# GitHub Pages demo builds set GITHUB_PAGES=true instead (see deploy workflow).
NEXT_PUBLIC_SITE_URL=
GITHUB_PAGES=

# --- Shared competition backend (Supabase/Postgres) -------------------------
# Enables: ranked leaderboards, Daily Arena shared boards, cross-device friend
# challenges, optional accounts + history sync.
# Apply supabase/migrations/0001_init.sql to your project first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Product analytics (consent-gated) --------------------------------------
# PostHog is loaded ONLY after the visitor grants analytics consent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# GA4 passthrough (forwards track() events when a gtag global exists).
NEXT_PUBLIC_GA_ID=

# --- Ads --------------------------------------------------------------------
# Ad slots are always reserved in layout; real markup loads only with a client id.
NEXT_PUBLIC_ADSENSE_CLIENT=

# --- Development-only TTS fallback ------------------------------------------
# Allows speechSynthesis in DEV when static audio is missing. ALWAYS stripped
# from production bundles; CI fails the build if it ever leaks.
NEXT_PUBLIC_DEV_TTS_FALLBACK=1
